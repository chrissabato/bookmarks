<Files "bookmarks.db">
    Require all denied
</Files>

# 1. Setup Shibboleth but don't force it yet
AuthType shibboleth
ShibRequestSetting requireSession 1
# The line below is often necessary to allow the IP check to pass 
# without immediately redirecting to the IDP
ShibRequestSetting redirectLimit 0 

<RequireAny>
    # 2. Check for the Campus Network
    Require ip 158.104.0.0/16
    
    # 3. If not on IP, require a specific Shibboleth user
    # Note: Using 'requireSession 1' inside the block or 
    # relying on the specific 'Require' to trigger the session.
    <RequireAll>
        Require shibboleth
        Require shib-user csabato
    </RequireAll>
</RequireAny>